# GEMINI_API_KEY: Required for Gemini AI API calls (SERVER SIDE ONLY)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Model Defaults
GEMINI_TEXT_MODEL="gemini-3.8-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# SUPABASE CONFIGURATION
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# SASPAY.ME PAYMENT GATEWAY (SERVER SIDE ONLY)
# Authorization: Bearer sk_test_... (dev) or sk_live_... (prod)
SASPAY_API_KEY="sk_test_your_saspay_key"
SASPAY_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# APP_URL: The URL where this applet is hosted (https://..., without trailing slash)
APP_URL="MY_APP_URL"
